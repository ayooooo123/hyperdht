{
  "name": "hyperdht",
  "version": "6.34.1",
  "description": "The DHT powering Hyperswarm",
  "main": "index.js",
  "browser": "browser.js",
  "bin": {
    "hyperdht": "bin.js"
  },
  "files": [
    "index.js",
    "browser.js",
    "testnet.js",
    "bin.js",
    "lib/**/*.js"
  ],
  "imports": {
    "events": {
      "bare": "bare-events",
      "default": "events"
    },
    "process": {
      "bare": "bare-process",
      "default": "process"
    },
    "fs": {
      "bare": "bare-fs",
      "default": "fs"
    },
    "child_process": {
      "bare": "bare-node-child-process",
      "default": "child_process"
    },
    "path": {
      "bare": "bare-path",
      "default": "path"
    },
    "os": {
      "bare": "bare-os",
      "default": "os"
    }
  },
  "dependencies": {
    "@hyperswarm/secret-stream": "6.9.1",
    "b4a": "^1.3.1",
    "bare-events": "^2.2.0",
    "bare-process": "4.5.1",
    "blind-relay": "1.6.1",
    "bogon": "^1.0.0",
    "compact-encoding": "^3.0.0",
    "dht-rpc": "https://codeload.github.com/ayooooo123/dht-rpc/tar.gz/fe04496196ea2ce42d1de27b0f770b02d2a87cd5",
    "hypercore-crypto": "^3.3.0",
    "hypercore-id-encoding": "^1.2.0",
    "hyperdht-address": "^1.0.1",
    "kademlia-routing-table": "^1.0.6",
    "noise-curve-ed": "^2.0.0",
    "noise-handshake": "^4.0.0",
    "record-cache": "^1.1.1",
    "safety-catch": "^1.0.1",
    "signal-promise": "^1.0.3",
    "sodium-native": "https://codeload.github.com/ayooooo123/sodium-native/tar.gz/562d642e1a78a8e124cf97bfbda77f01c02d1a7f",
    "sodium-universal": "^5.0.1",
    "streamx": "2.28.1",
    "udx-native": "1.20.7",
    "unslab": "^1.3.0",
    "xache": "^1.1.0"
  },
  "overrides": {
    "sodium-native": "https://codeload.github.com/ayooooo123/sodium-native/tar.gz/562d642e1a78a8e124cf97bfbda77f01c02d1a7f",
    "bare-assert": "1.2.0",
    "bare-dns": "~2.1.4",
    "bare-inspect": "3.1.4",
    "bare-structured-clone": "1.6.0",
    "bare-subprocess": "6.1.0",
    "bare-type": "~1.1.1"
  },
  "devDependencies": {
    "bare-fs": "4.7.4",
    "bare-node-child-process": "^1.0.1",
    "bare-os": "^3.9.3",
    "bare-path": "^3.1.2",
    "bare-runtime": "1.30.3",
    "brittle": "^3.0.0",
    "graceful-goodbye": "^1.3.0",
    "newline-decoder": "^1.0.2",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0",
    "protomux": "^3.12.1"
  },
  "scripts": {
    "format": "prettier --write .",
    "test": "prettier --check . && node test/all.js",
    "test:bare": "node -e \"const {spawnSync}=require('child_process');process.exit(spawnSync(require('bare-runtime')('bare'),['test/all.js'],{stdio:'inherit'}).status??1)\"",
    "test:generate": "brittle -r test/all.js test/*.js",
    "test:e2e": "node test/e2e.js",
    "test:e2e:bare": "bare test/e2e.js",
    "test:e2e:generate": "brittle -r test/e2e.js test/e2e/*.js",
    "test:e2e:b1": "brittle test/e2e/b1/*.js",
    "test:e2e:b1:bare": "brittle-bare test/e2e/b1/*.js",
    "test:e2e:c2:diversity": "node test/e2e/c2/diversity/index.js",
    "bench:private-routing": "node bench/private-routing/index.js",
    "integration": "brittle test/integration/*.js",
    "end-to-end": "brittle test/end-to-end/*.js"
  },
  "author": "Mathias Buus (@mafintosh)",
  "license": "MIT",
  "directories": {
    "doc": "docs",
    "example": "examples",
    "lib": "lib",
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holepunchto/hyperdht.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/holepunchto/hyperdht/issues"
  },
  "homepage": "https://github.com/holepunchto/hyperdht#readme",
  "type": "commonjs"
}
